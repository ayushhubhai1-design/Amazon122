# Add these in Railway -> your service -> Variables.
# Do not commit a real .env file or paste secrets into public GitHub repositories.
BOT_TOKEN=replace_with_a_NEW_token_from_BotFather
CHAT_ID=replace_with_your_telegram_chat_id

# Optional integrations/settings; leave blank unless you use them.
PREMIUM_CHAT_ID=
ALERT_CHANNEL_ID=
DISCORD_WEBHOOK_URL=
NTFY_TOPIC=
KEEPA_API_KEY=
REDIS_URL=
RESIDENTIAL_PROXY_URL=

# Start conservatively; increase later if Railway resources allow.
SCAN_WORKERS=10
MONITOR_INTERVAL_SECONDS=60
MAX_MONITOR_INTERVAL_SECONDS=180
TELEGRAM_RETRIES=4
MAX_ALERT_PRICE=0
FLIPKART_ENABLED=1
WARMUP_ENABLED=1
